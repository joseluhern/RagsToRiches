<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RagsToRiches.GoodEnding"
             Title="Good Ending"
             Shell.BackgroundColor="black"
             Shell.ForegroundColor="White"
             BackgroundColor="DarkKhaki">

    <Grid>
        <!--<Image
        Source="choosegamebackground.jpg"
        Aspect="AspectFill"/> -->

        <ScrollView>
            <VerticalStackLayout>

                <Border
                    Stroke="White"
                    StrokeThickness="4"
                    HorizontalOptions="Center"
                    Background="Black"
                    Margin="20"
                    Padding="20">
                    <StackLayout>
             <Label
            Text="YAYYY YOU DID IT THIS IS THE GOOD ENDING"
            FontSize="50"
            Style="{StaticResource Headline}"
                FontAttributes="Bold">

                    <Label.Shadow>
                        <Shadow
                            Brush="White"
                            Opacity="1"
                            Radius="15"
                            Offset="0,0"/>
                    </Label.Shadow>
                </Label>

                <Label
            Text="Your a WINNER"
            FontSize="40"
            Style="{StaticResource SubHeadline}"/>
                </StackLayout>
                </Border>

                <Border
                    Stroke="White"
                    StrokeThickness="10"
                    StrokeShape="RoundRectangle 30"
                    HorizontalOptions="Center"
                    Margin="20">

                    <Image
                    Source="winimage.jpg"
                    HeightRequest="300"
                    Aspect="AspectFit"/>
                </Border>

                <Border
                     Stroke="White"
                     StrokeThickness="4"
                     HorizontalOptions="Center"
                     Background="White"
                     Margin="20"
                     Padding="20">
                <Label
                 x:Name="MoneyCount"
                 Text="Money: $0.00"
                 HorizontalOptions="Center"
                 TextColor="DarkGreen"
                 FontSize="100"
                 FontAttributes="Bold">

                    <Label.Shadow>
                        <Shadow
                             Brush="White"
                             Opacity="1"
                             Radius="15"
                             Offset="0,0"/>
                    </Label.Shadow>

                </Label>
                </Border>

                <Button
            x:Name="returnToJobOrGambleGame"
            Text="let me win again heheheh"
            Clicked="GoToJobOrGambleMenu"
            BackgroundColor="LightBlue"
            Padding="20"
            Margin="30"
            BorderColor="Black"
            BorderWidth="7"
            FontSize="70"/>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>