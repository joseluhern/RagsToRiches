<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RagsToRiches.ChooseGambleGame"
             Title="Choose Your Gambling Game"
             Shell.BackgroundColor="black"
             Shell.ForegroundColor="White">

    <Grid>
        <Image
            Source="choosegamebackground.jpg"
            Aspect="AspectFill"/>

        <ScrollView>
            <VerticalStackLayout>

                <Label
                        Text="PICK YOUR POISON, SCUM!!"
                        Style="{StaticResource Headline}" 
                        FontAttributes="Bold">

                    <Label.Shadow>
                        <Shadow
                            Brush="White"
                            Opacity="1"
                            Radius="15"
                            Offset="0,0"/>
                    </Label.Shadow>
                </Label>

                <Label
                        Text="(Please choose one of the following gambling games below)"
                        Style="{StaticResource SubHeadline}"/>

                <Grid ColumnDefinitions="*,*,*">

                    <Grid Grid.Column="0" RowDefinitions="Auto,*">

                        <Label
                        Grid.Row="0"
                        Text="Slots"
                        FontSize="20"
                        HorizontalOptions="Center"/>

                        <ImageButton
                        Grid.Row="1"
                        x:Name="slotsGame"
                        Source="slots.jpg"
                        Clicked="GoToSlotsGame"
                        BackgroundColor="Red"
                        Padding="20"
                        Margin="30"
                        HeightRequest="400"
                        BorderColor="White"
                        BorderWidth="10"/>

                    </Grid>

                    <Grid Grid.Column="1" RowDefinitions="Auto,*">

                        <Label
                            Grid.Row="0"
                            Text="Black Jack"
                            FontSize="20"
                            HorizontalOptions="Center"/>    


                        <ImageButton
                            Grid.Row="1"
                            x:Name="blackJackGame"
                            Source="blackjack.jpg"
                            Clicked="GoToBlackJack"
                            BackgroundColor="DarkGray"
                            Padding="20"
                            Margin="30"
                            HeightRequest="400"
                            BorderColor="White"
                            BorderWidth="10"/>
                    </Grid>

                    <Grid Grid.Column="2" RowDefinitions="Auto,*">

                        <Label
                            Grid.Row="0"
                            Text="Roulette"
                            FontSize="20"
                            HorizontalOptions="Center"/>        

                        <ImageButton
                            Grid.Row="1"
                            x:Name="rouletteGame"
                            Source="roullette.jpg"
                            Clicked="GoToRoulette"
                            BackgroundColor="Green"
                            Padding="20"
                            Margin="30"
                            HeightRequest="400"
                            BorderColor="White"
                            BorderWidth="10"/>
                        
                    </Grid>
                </Grid>

                <Button
                    x:Name="returnToJobOrGambleGame"
                    Text="IM SCARED RETURN ME"
                    Clicked="GoToJobOrGambleMenu"
                    BackgroundColor="LightBlue"
                    Padding="20"
                    Margin="30"
                    BorderColor="Black"
                    BorderWidth="7"/>       

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>