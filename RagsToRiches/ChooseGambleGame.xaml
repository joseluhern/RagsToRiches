<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RagsToRiches.ChooseGambleGame"
             Title="Choose Your Gambling Game">

    <Grid>
        <Image
            Source="choosegamebackground.jpg"
            Aspect="AspectFill"/>

        <ScrollView>
            <VerticalStackLayout>

                <Label
                        Text="PICK YOUR POISON SCUM!!"
                        Style="{StaticResource Headline}" />

                <Label
                        Text="(Please choose one of the following gambling games below"
                        Style="{StaticResource SubHeadline}"/>

                <Grid ColumnDefinitions="*,*,*">
                
                    <ImageButton
                        Grid.Column="0"
                        x:Name="slotsGame"
                        Source="dotnet_bot.png"
                        Clicked="GoToSlotsGame"
                        BackgroundColor="Red"
                        Padding="20"
                        Margin="30"
                        HeightRequest="400"
                        BorderColor="White"
                        BorderWidth="10"/>

                    <Button
                        Grid.Column="1"
                        x:Name="blackJackGame"
                        Text="BLACKJACK"
                        BackgroundColor="DarkGray"
                        Padding="20"
                        Margin="30"
                        HeightRequest="400"
                        BorderColor="White"
                        BorderWidth="10"/>

                    <Button
                        Grid.Column="2"
                        x:Name="rouletteGame"
                        Text="ROULETTE"
                        BackgroundColor="Green"
                        Padding="20"
                        Margin="30"
                        HeightRequest="400"
                        BorderColor="White"
                        BorderWidth="10"/>
                    
                </Grid>

                <Button
                    x:Name="returnToJobOrGambleGame"
                    Text="IM SCARED RETURN ME"
                    Clicked="GoToJobOrGambleMenu"
                    BackgroundColor="LightBlue"
                    Padding="20"
                    Margin="30"
                    BorderColor="Black"
                    BorderWidth="7"/>       

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>