<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RagsToRiches.BadEnding"
             Title="Bad Ending"
             Shell.BackgroundColor="black"
             Shell.ForegroundColor="White"
             BackgroundColor="Gray">
    <Grid>
        <!--<Image
            Source="choosegamebackground.jpg"
            Aspect="AspectFill"/> -->

        <ScrollView>
            <VerticalStackLayout>

                <Label
                Text="welcome to the bad ending...."
                Style="{StaticResource Headline}"
                FontAttributes="Bold">

                    <Label.Shadow>
                        <Shadow
                            Brush="White"
                            Opacity="1"
                            Radius="15"
                            Offset="0,0"/>
                    </Label.Shadow>
                </Label>

                <Label
                Text="Your a loser"
                Style="{StaticResource SubHeadline}"/>

                <Button
                x:Name="returnToJobOrGambleGame"
                Text="wait noo let me try againn"
                Clicked="GoToJobOrGambleMenu"
                BackgroundColor="Red"
                Padding="20"
                Margin="30"
                BorderColor="Black"
                BorderWidth="7"/>   

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>